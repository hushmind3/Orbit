# Settings can also be saved in the local operator dashboard; do not commit real secrets.
ORBIT_LLM_PROVIDER=openai
ORBIT_LLM_BASE_URL=https://api.example.com/v1
ORBIT_LLM_MODEL=your-model-name
ORBIT_LLM_API_KEY=
ORBIT_OWNER_WHATSAPP=821012345678

# WhatsApp Business Cloud API credentials: Meta App -> WhatsApp -> API Setup
WA_BUSINESS_NUMBER=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0

# Twilio Verify for phone-number OTP, and Voice for outgoing calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
ORBIT_PUBLIC_URL=https://your-secure-domain.example
